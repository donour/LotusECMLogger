<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CcpSimulator/CcpSimulator.csproj" />
    <Using Include="LotusECMLogger.Services.Ccp.Simulation" />
  </ItemGroup>
  <ItemGroup>
    <!-- The high-speed logger is the CCP DAQ consumer. Its pure sources are linked so it can be tested
         against the simulator without loading WinForms or J2534. -->
    <Compile Include="../LotusECMLogger/Models/HighSpeedChannel.cs" Link="HighSpeedLog/%(Filename)%(Extension)" />
    <Compile Include="../LotusECMLogger/Services/HighSpeedLogPlanner.cs" Link="HighSpeedLog/%(Filename)%(Extension)" />
    <Compile Include="../LotusECMLogger/Services/HighSpeedLogLegacyCommands.cs" Link="HighSpeedLog/%(Filename)%(Extension)" />
    <Compile Include="../LotusECMLogger/HighSpeedLogPresetLoader.cs" Link="HighSpeedLog/%(Filename)%(Extension)" />
    <Compile Include="../LotusECMLogger/Services/SymbolCatalog.cs" Link="HighSpeedLog/%(Filename)%(Extension)" />
    <Compile Include="../LotusECMLogger/Services/SymbolCatalogLoader.cs" Link="HighSpeedLog/%(Filename)%(Extension)" />
    <Compile Include="../LotusECMLogger/Services/ChannelTypeParser.cs" Link="HighSpeedLog/%(Filename)%(Extension)" />
    <!-- The presets and symbol catalogs, found through the same discovery path the app uses. -->
    <None Include="../LotusECMLogger/config/highSpeedLogger/**/*.json;../LotusECMLogger/config/highSpeedLogger/**/*.csv"
          LinkBase="config/highSpeedLogger" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
