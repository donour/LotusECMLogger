<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches the app it tests: the project reference below is only valid for a compatible
         Windows target, and the solution builds everything as x86. -->
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x86</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LotusECMLogger\LotusECMLogger.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The configuration tests read the real shipped configs through the same discovery path the
         app uses, so they have to sit under config\obdLogger in the test output too. -->
    <None Include="..\LotusECMLogger\config\obdLogger\*.json"
          Link="config\obdLogger\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The CCP tab's UI test drives the real control against the simulated ECU. Only the simulation files are
         linked; the CCP protocol types come from the app itself. -->
    <Compile Include="..\CcpSimulator\FakeCcpSlave.cs" Link="CcpSimulation\%(Filename)%(Extension)" />
    <Compile Include="..\CcpSimulator\SimulatedCcpTransport.cs" Link="CcpSimulation\%(Filename)%(Extension)" />
    <Compile Include="..\CcpSimulator\T6FirmwareImage.cs" Link="CcpSimulation\%(Filename)%(Extension)" />
    <!-- Symbol catalogs, found through the app's discovery path, for the CCP tab's variables and diff names. -->
    <None Include="..\LotusECMLogger\config\highSpeedLogger\database\*.csv"
          Link="config\highSpeedLogger\database\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
