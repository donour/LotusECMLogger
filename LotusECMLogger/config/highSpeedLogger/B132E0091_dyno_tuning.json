{
  // Dyno power-run preset for the B13200091 ECU. Built for a stationary dyno pull: per-cylinder
  // ignition/knock at full resolution, the fault/limiter channels that can silently cap a power
  // number (misfire, torque reduction, rev limit), the MAF-vs-Alpha-N load cross-check, VVT tracking,
  // and closed-loop fuel trims — everything needed to explain a dip or a flat spot on the graph.
  //
  // Per-cylinder [6] symbols are hidden from logging by the catalog (arrays aren't loggable as a
  // single channel), so they are expanded to one explicit address channel per cylinder, base +
  // index*element_size, following the convention in B13200091_ignition_tuning.json:
  //   knock_retard_per_cyl              short[6]         @ 0x400059f4 (2 B signed, raw counts)
  //   obd_ii_ign_adv_per_cylinder       i16_angle_1/4[6] @ 0x40001796 (2 B signed, deg = raw/4)
  //   ign_knock_retard                  u8_angle_1/4deg[6] @ 0x40001c20 (1 B, deg = raw/4, learned/persistent)
  //   ign_knock_retard_octane_margin    u8_angle_1/4deg[6] @ 0x40001c28 (1 B, deg = raw/4, active/instantaneous)
  // Cylinder order is the array index (1-6), not the firing order.
  //
  // No symbol named "torque_reduction_applied" exists in the B13200091 catalog. The closest direct
  // signal for "is the ECU actively pulling torque back right now" is torque_limit_active_cyl_cut_count
  // (nonzero = cylinders are being cut) — used in its place below.
  //
  // engine_speed_3 is the coarse 8-bit RPM copy (u8_rspeed_125/4+500rpm -> +500 rpm offset, ~31 rpm
  // resolution); it's included alongside the precise engine_speed_16bit only because it was asked for
  // explicitly — prefer engine_speed_16bit for anything actually read off the trace.
  //
  // Single 50 Hz tier for everything that moves during a pull (49 channels, ~86 B/sample-set ~= 4.3
  // kB/s), plus 20 Hz for VVT tracking (9 channels) and 10 Hz for slow context (6 channels). Rough
  // payload-only estimate, ignoring ISO-TP/CAN framing overhead: ~4.7 kB/s raw ~= 38 kbit/s, single-
  // digit percent of the 500 kbit/s bus before overhead -- comparable presets in this folder run
  // ~9-16% once framing is counted, so expect this one on the higher end of that range. Configure with
  // the engine off per this folder's README, then use Test Connection before a real pull.
  "name": "Dyno Power Tuning (B132E0091)",
  "description": "Dyno power-run trace: per-cylinder ignition advance and knock (active + learned), misfire/torque-reduction/rev-limit channels, MAF-vs-Alpha-N load, throttle, AFR target, closed-loop fuel trims, and VVT tracking.",
  "ecuVersion": "B13200091",
  "channels": [
    // ── 50 Hz ─────────────────────────────────────────────────────────────────────────────────────
    {
      "symbol": "engine_speed_16bit",
      "rate": 50
    }, // RPM, precise (1 rpm/count) -- primary X axis
    // Knock-driven timing retard per cylinder -- knock_retard_per_cyl, short[6] @ 0x400059f4
    {
      "name": "Knock Retard Per Cyl 1",
      "address": "0x400059f4",
      "size": 2,
      "signed": true,
      "unit": "raw",
      "defaultSelected": true,
      "rate": 50
    },
    {
      "name": "Knock Retard Per Cyl 2",
      "address": "0x400059f6",
      "size": 2,
      "signed": true,
      "unit": "raw",
      "defaultSelected": true,
      "rate": 50
    },
    {
      "name": "Knock Retard Per Cyl 3",
      "address": "0x400059f8",
      "size": 2,
      "signed": true,
      "unit": "raw",
      "defaultSelected": true,
      "rate": 50
    },
    {
      "name": "Knock Retard Per Cyl 4",
      "address": "0x400059fa",
      "size": 2,
      "signed": true,
      "unit": "raw",
      "defaultSelected": true,
      "rate": 50
    },
    {
      "name": "Knock Retard Per Cyl 5",
      "address": "0x400059fc",
      "size": 2,
      "signed": true,
      "unit": "raw",
      "defaultSelected": true,
      "rate": 50
    },
    {
      "name": "Knock Retard Per Cyl 6",
      "address": "0x400059fe",
      "size": 2,
      "signed": true,
      "unit": "raw",
      "defaultSelected": true,
      "rate": 50
    },

    {
      "symbol": "knock_ign_retard_sum",
      "rate": 50
    }, // Total knock retard, all cylinders (deg = raw/4)

    // Ignition advance per cylinder -- obd_ii_ign_adv_per_cylinder, i16_angle_1/4[6] @ 0x40001796
