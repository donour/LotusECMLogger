<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x86</Platforms>
    <ApplicationIcon>assets\audio_video_media_control_resume_plain_icon_260667.ico</ApplicationIcon>
    <Version>0.7.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\audio_video_media_control_resume_plain_icon_260667.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="J2534-Sharp.Core" Version="2.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BinaryFileMonitor\BinaryFileMonitor.csproj" />
    <ProjectReference Include="..\CrpTools\CrpTools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The OBD decoders (LiveDataReading and friends) are internal to the app but are pure
         functions over response buffers, and the multi-PID cursor they drive can only be
         exercised by calling them directly. -->
    <InternalsVisibleTo Include="LotusECMLogger.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hand-authored rather than added through the VS "User Control" template, so the designer
         association is declared explicitly instead of relying on auto-detection. -->
    <Compile Update="Controls\AbsControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Controls\AbsControl.Designer.cs">
      <DependentUpon>AbsControl.cs</DependentUpon>
    </Compile>
    <Compile Update="Controls\Mode13Control.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Controls\Mode13Control.Designer.cs">
      <DependentUpon>Mode13Control.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Controls\VehicleInfoControl.resx">
      <DependentUpon>VehicleInfoControl.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Controls\DTCControl.resx">
      <DependentUpon>DTCControl.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Controls\Mode13Control.resx">
      <DependentUpon>Mode13Control.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Auto-copy all config JSON files and ECU symbol databases to the output directory -->
    <None Update="config\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config\**\*.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
