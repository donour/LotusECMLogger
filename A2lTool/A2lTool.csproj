<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The generator and reader are app sources; they and the catalog loader are linked, not referenced, so the
         tool runs without WinForms or J2534. -->
    <Compile Include="../LotusECMLogger/Services/A2l/*.cs" Link="A2l/%(Filename)%(Extension)" />
    <Compile Include="../LotusECMLogger/Services/Ccp/CcpTarget.cs" Link="Catalog/%(Filename)%(Extension)" />
    <Compile Include="../LotusECMLogger/Services/SymbolCatalog.cs" Link="Catalog/%(Filename)%(Extension)" />
    <Compile Include="../LotusECMLogger/Services/SymbolCatalogLoader.cs" Link="Catalog/%(Filename)%(Extension)" />
    <Compile Include="../LotusECMLogger/Services/ChannelTypeParser.cs" Link="Catalog/%(Filename)%(Extension)" />
    <None Include="../LotusECMLogger/config/highSpeedLogger/database/*.csv" LinkBase="config/highSpeedLogger/database"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
